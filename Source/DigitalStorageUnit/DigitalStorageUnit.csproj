<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Digital Storage Unit (RimWorld 1.7 rewrite)
    Build:   dotnet build -c Release
    Output:  ../../1.7/Assemblies/DigitalStorageUnit.dll
    RimWorld 1.7 runs on .NET 10 (Waylith CLR) - same setup as Project RimFactory Revived 1.7.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DigitalStorageUnit</AssemblyName>
    <RootNamespace>DigitalStorageUnit</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>..\..\1.7\Assemblies\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <Version>2.0.0</Version>
    <!-- Do not copy any dependency into Assemblies -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same reference packages as Project RimFactory Revived (1.7 build) -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" />
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.3" ExcludeAssets="runtime" PrivateAssets="All" />
  </ItemGroup>

</Project>
